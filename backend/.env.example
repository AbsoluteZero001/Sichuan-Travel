# 复制本文件为 backend/.env，并填入大模型 API 配置
# 也可直接配置系统环境变量，项目会优先读取真实环境变量
# 真实 API Key 只能保存在后端 .env / 环境变量中，前端不会读取

AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=20

# OpenAI 兼容接口，按实际服务商填写。示例：
# OpenAI:    AI_BASE_URL=https://api.openai.com/v1
#            AI_MODEL=gpt-4o-mini
# DeepSeek:  AI_BASE_URL=https://api.deepseek.com/v1
#            AI_MODEL=deepseek-chat
# Qwen:      AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#            AI_MODEL=qwen-plus

# 兼容旧变量名（如已使用 LLM_*，仍可继续生效，无需改动）：
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL / LLM_TIMEOUT
